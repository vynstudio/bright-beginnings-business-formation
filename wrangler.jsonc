// Cloudflare Workers static hosting for the built site (npm run build → dist/).
// Deploy: npx wrangler deploy
{
  "name": "agente-registrado-florida",
  "compatibility_date": "2026-10-01",
  // Small worker in front of the site: redirects, per-page SEO tags, 404s and the maintenance switch.
  "main": "worker/index.js",
  "vars": {
    // "on" shows the "back soon" page on agenteregistradofl.com (the preview stays normal); "off" serves the site.
    "MAINTENANCE": "off"
  },
  // Keeps the *.workers.dev preview address working alongside the domain.
  "workers_dev": true,
  "routes": [
    { "pattern": "agenteregistradofl.com", "custom_domain": true },
    { "pattern": "www.agenteregistradofl.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Every request goes through the worker first, so redirects and the maintenance page cover every address.
    "run_worker_first": true,
    // Single-page app: unknown paths like /blog/my-post load index.html and React Router takes over.
    "not_found_handling": "single-page-application"
  }
}
