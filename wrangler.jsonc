// Cloudflare Workers static hosting for the built site (npm run build → dist/).
// Deploy: npx wrangler deploy
{
  "name": "agente-registrado-florida",
  "compatibility_date": "2026-10-01",
  // Keeps the *.workers.dev preview address working alongside the domain.
  "workers_dev": true,
  "routes": [
    { "pattern": "agenteregistradofl.com", "custom_domain": true },
    { "pattern": "www.agenteregistradofl.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    // Single-page app: unknown paths like /blog/my-post load index.html and React Router takes over.
    "not_found_handling": "single-page-application"
  }
}
